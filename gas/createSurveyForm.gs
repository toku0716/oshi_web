/**
 * ==============================================================================
 * 推しサポ (Oshi Support / Oshis-web)
 * アンケート Googleフォーム＆回答スプレッドシート自動生成スクリプト (GAS)
 * ==============================================================================
 * 
 * 【使い方】
 * 1. Google ドライブ (https://drive.google.com/) または
 *    Google Apps Script (https://script.google.com/) を開きます。
 * 2. 「新しいプロジェクト」を作成します。
 * 3. このコードをエディタにすべて貼り付けて保存 (Ctrl+S / Cmd+S) します。
 * 4. 上部の実行関数で「createSurveyForm」を選択し、「実行」ボタンを押します。
 * 5. 初回のみアクセス権限の承認画面が表示されるので許可します。
 *    （「詳細」→「無題のプロジェクト（安全ではないページ）に移動」→「許可」）
 * 6. 実行ログ（Logger）に出力された「回答用URL」を、推しサポの
 *    「マイページ」→「アンケート・改善要望を送る」→「URL設定」に貼り付ければ完了です！
 * ==============================================================================
 */

function createSurveyForm() {
  const FORM_TITLE = '【推しサポ】アプリご利用アンケート＆改善ご要望';
  const FORM_DESCRIPTION = 
    '推し活管理アプリ「推しサポ (Oshis-web)」をご利用いただき誠にありがとうございます！\n' +
    '皆さまの推し活をより快適に、楽しくサポートできるよう、ご意見・ご感想・ご要望をお聞かせください。\n\n' +
    '⏱ 所要時間：約1〜2分（匿名・スキップ可）';

  // 1. Googleフォームの新規作成
  const form = FormApp.create(FORM_TITLE);
  form.setDescription(FORM_DESCRIPTION);
  form.setAllowResponseEdits(false);
  form.setLimitOneResponsePerUser(false); // 匿名・気軽な複数回回答を許可
  form.setShowLinkToRespondAgain(true);
  form.setConfirmationMessage('アンケートにご回答いただき誠にありがとうございます！✨\nいただいた貴重なご意見をもとに、より使いやすい推し活アプリへアップデートしてまいります。');

  // --------------------------------------------------------------------------
  // 質問1: 主に利用している端末・環境 (単一選択)
  // --------------------------------------------------------------------------
  const itemDevice = form.addMultipleChoiceItem();
  itemDevice.setTitle('1. 推しサポを主にどの端末でご利用ですか？')
    .setHelpText('当てはまるものを1つお選びください')
    .setRequired(true)
    .setChoiceValues([
      'スマートフォン (iPhone / Safari / PWA)',
      'スマートフォン (Android / Chrome / PWA)',
      'パソコン (Mac / Windows ブラウザ)',
      'タブレット (iPadなど)',
      '複数端末（スマホとPCなど）を同期して併用している'
    ]);

  // --------------------------------------------------------------------------
  // 質問2: アプリ全体の使いやすさ・満足度 (リニアスケール 1〜5)
  // --------------------------------------------------------------------------
  const itemRating = form.addScaleItem();
  itemRating.setTitle('2. 推しサポの全体の使いやすさ・満足度を教えてください')
    .setBounds(1, 5)
    .setLabels('使いにくい', 'とても満足')
    .setRequired(true);

  // --------------------------------------------------------------------------
  // 質問3: 特によく使っている・気に入っている機能 (チェックボックス / 複数選択可)
  // --------------------------------------------------------------------------
  const itemFeatures = form.addCheckboxItem();
  itemFeatures.setTitle('3. 特によく使っている、または気に入っている機能は何ですか？（複数選択可）')
    .setHelpText('当てはまるものをすべてお選びください')
    .setChoiceValues([
      '今日・直近の予定＆リアルタイムカウントダウン',
      'カレンダー（月間カレンダー・推しの記念日バナー）',
      'スマート時刻入力キーパッド（直感的な時間入力）',
      'チケット管理（当選・当落・入金締切・発券）',
      'TODO・やることリスト',
      'グッズ管理（一覧・所持/予約/欲しいものステータス）',
      'グッズの保管場所整理（棚・ボックス別管理）',
      '推し活支出記録・収支統計グラフ（カテゴリ別集計）',
      '複数推し登録・推しカラー変更機能',
      'スマホとPCの端末間P2P直接同期（6桁コード/QR）',
      'データのバックアップ・復元（JSON）',
      'ダークモード / ライトモード表示'
    ])
    .showOtherOption(true);

  // --------------------------------------------------------------------------
  // 質問4: デザイン・操作感について (単一選択)
  // --------------------------------------------------------------------------
  const itemDesign = form.addMultipleChoiceItem();
  itemDesign.setTitle('4. デザインや画面の見やすさ・操作感はいかがですか？')
    .setChoiceValues([
      'とても見やすく、操作しやすい',
      'おおむね見やすく使いやすい',
      '普通',
      '一部の文字やボタンが小さく押しにくい／見づらい',
      '使いにくい・分かりにくい'
    ])
    .setRequired(false);

  // --------------------------------------------------------------------------
  // 質問5: 今後欲しい機能・改善してほしい点 (チェックボックス / 複数選択可)
  // --------------------------------------------------------------------------
  const itemWishlist = form.addCheckboxItem();
  itemWishlist.setTitle('5. 今後追加してほしい機能や改善してほしい点はありますか？（複数選択可）')
    .setHelpText('今後の開発の優先度付けに活用させていただきます')
    .setChoiceValues([
      '予定やチケット締切のプッシュ通知・リマインド機能',
      'Googleカレンダー / iOSカレンダーとの連携・出力',
      '遠征専用管理（遠征費・ホテル・交通・行程表）',
      'グッズの定価・フリマ相場メモ機能',
      'ホーム画面に置けるスマホウィジェット対応',
      '推しの写真・スクショ・公式SNSリンクまとめ機能',
      '推し友との予定やグッズリストの共有機能',
      'オフライン時や同期のさらなる安定化'
    ])
    .showOtherOption(true);

  // --------------------------------------------------------------------------
  // 質問6: 画面が見づらかった箇所・操作しにくかった箇所 (自由記述)
  // --------------------------------------------------------------------------
  const itemIssues = form.addParagraphTextItem();
  itemIssues.setTitle('6. 画面が見づらかった箇所や、操作に迷った点があれば教えてください')
    .setHelpText('ダークモードでの文字色、ボタンの押しやすさ、入力の手間など、気になる点があればご自由にお書きください（任意）')
    .setRequired(false);

  // --------------------------------------------------------------------------
  // 質問7: 自由記述・応援メッセージ (自由記述)
  // --------------------------------------------------------------------------
  const itemMessage = form.addParagraphTextItem();
  itemMessage.setTitle('7. その他、ご要望や開発者へのメッセージがあればご自由にお聞かせください！')
    .setHelpText('「こんな機能が欲しい！」「ここが推し活に役立っている！」など何でも大歓迎です（任意）')
    .setRequired(false);

  // --------------------------------------------------------------------------
  // 2. 回答集計用スプレッドシートの新規作成とフォーム連携
  // --------------------------------------------------------------------------
  const spreadsheet = SpreadsheetApp.create('【回答集計】推しサポ アンケート結果');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, spreadsheet.getId());

  // --------------------------------------------------------------------------
  // 3. 各種URLの取得とログ出力
  // --------------------------------------------------------------------------
  const publishedUrl = form.getPublishedUrl();
  const editUrl = form.getEditUrl();
  const spreadsheetUrl = spreadsheet.getUrl();
  const embedUrl = publishedUrl + (publishedUrl.includes('?') ? '&embedded=true' : '?embedded=true');

  Logger.log('================================================================');
  Logger.log('🎉 推しサポ アンケートGoogleフォームの作成が完了しました！');
  Logger.log('================================================================');
  Logger.log('');
  Logger.log('【1. アプリ設定用の回答フォームURL】');
  Logger.log(publishedUrl);
  Logger.log('');
  Logger.log('【2. アプリ内埋め込み用URL (iFrame用)】');
  Logger.log(embedUrl);
  Logger.log('');
  Logger.log('【3. フォーム編集画面URL】');
  Logger.log(editUrl);
  Logger.log('');
  Logger.log('【4. 回答集計スプレッドシートURL】');
  Logger.log(spreadsheetUrl);
  Logger.log('');
  Logger.log('================================================================');
  Logger.log('💡 次のステップ:');
  Logger.log('上記「【1. アプリ設定用の回答フォームURL】」をコピーして、');
  Logger.log('推しサポの「マイページ」→「アンケート・改善要望を送る」→「URL設定」に貼り付けてください。');
  Logger.log('================================================================');

  return {
    publishedUrl: publishedUrl,
    embedUrl: embedUrl,
    editUrl: editUrl,
    spreadsheetUrl: spreadsheetUrl,
  };
}
