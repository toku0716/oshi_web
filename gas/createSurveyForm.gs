/**
 * ==============================================================================
 * 推しサポ (Oshi Support) - アンケート Googleフォーム自動生成スクリプト (GAS)
 * ==============================================================================
 * 
 * 【使い方】
 * 1. Google ドライブ (https://drive.google.com/) または
 *    Google Apps Script (https://script.google.com/) を開きます。
 * 2. 「新しいプロジェクト」を作成します。
 * 3. このコードをエディタにすべて貼り付けて保存 (Ctrl+S / Cmd+S) します。
 * 4. 上部の実行関数で「createSurveyForm」を選択し、「実行」ボタンを押します。
 * 5. 初回のみアクセス権限の承認画面（「詳細」→「安全ではないページに移動」→「許可」）が表示されるので承認します。
 * 6. 実行ログ（Logger）に表示された「回答用URL」を、推しサポの
 *    「マイページ」→「アンケート・改善要望を送る」→「URL設定」に貼り付けます。
 * ==============================================================================
 */

function createSurveyForm() {
  const FORM_TITLE = '【推しサポ】アプリ改善・ご意見アンケート';
  const FORM_DESCRIPTION = 
    '推し活管理アプリ「推しサポ」をご利用いただきありがとうございます！\n' +
    '皆さまの推し活をより快適で楽しくサポートできるよう、ご意見・ご要望をお聞かせください。\n\n' +
    '⏱ 所要時間：約1〜2分（匿名でご回答いただけます）';

  // 1. Googleフォームの新規作成
  const form = FormApp.create(FORM_TITLE);
  form.setDescription(FORM_DESCRIPTION);
  form.setAllowResponseEdits(false);
  form.setLimitOneResponsePerUser(false); // 匿名・気軽な複数回回答を許可
  form.setShowLinkToRespondAgain(true);
  form.setConfirmationMessage('アンケートにご協力いただき誠にありがとうございました！✨\nいただいたご意見をもとに、推しサポをより便利にアップデートしてまいります。');

  // --------------------------------------------------------------------------
  // 質問1: 主に利用している端末 (単一選択)
  // --------------------------------------------------------------------------
  const itemDevice = form.addMultipleChoiceItem();
  itemDevice.setTitle('1. 推しサポを主にどの端末でご利用ですか？')
    .setHelpText('当てはまるものを1つお選びください')
    .setRequired(true)
    .setChoiceValues([
      'スマートフォン (iPhone / Android)',
      'パソコン (Mac / Windows)',
      'タブレット (iPadなど)',
      '複数端末で直接同期して併用している'
    ]);

  // --------------------------------------------------------------------------
  // 質問2: アプリ全体の満足度 (リニアスケール 1〜5)
  // --------------------------------------------------------------------------
  const itemRating = form.addScaleItem();
  itemRating.setTitle('2. 推しサポの全体の満足度を教えてください')
    .setBounds(1, 5)
    .setLabels('不満', '大変満足')
    .setRequired(true);

  // --------------------------------------------------------------------------
  // 質問3: 特によく使っている機能 (チェックボックス / 複数選択可)
  // --------------------------------------------------------------------------
  const itemFeatures = form.addCheckboxItem();
  itemFeatures.setTitle('3. 特によく使っている機能は何ですか？（複数選択可）')
    .setHelpText('普段活用している機能をすべてお選びください')
    .setChoiceValues([
      '今日・直近の予定＆リアルタイムカウントダウン',
      'カレンダー（イベント・記念日・ライブの予定管理）',
      'チケット管理（当選・申込・入金締切ステータス）',
      'TODO・やることリスト',
      'グッズ一覧＆所持・予約・欲しいもの管理',
      'グッズ保管場所別の整理',
      '推し活支出記録・収支統計グラフ',
      'スマホ・PC 端末間直接同期 (P2P / 6桁コード)',
      'データの保存・復元 (JSONバックアップ)'
    ])
    .showOtherOption(true);

  // --------------------------------------------------------------------------
  // 質問4: デザイン・見やすさについて (単一選択)
  // --------------------------------------------------------------------------
  const itemDesign = form.addMultipleChoiceItem();
  itemDesign.setTitle('4. デザインや画面の見やすさ・使いやすさはいかがですか？')
    .setChoiceValues([
      'とても見やすく、使いやすい',
      'おおむね使いやすい',
      '普通',
      '一部見にくい・わかりにくい部分がある',
      '使いにくい'
    ])
    .setRequired(false);

  // --------------------------------------------------------------------------
  // 質問5: 今後欲しい機能・改善点 (チェックボックス / 複数選択可)
  // --------------------------------------------------------------------------
  const itemWishlist = form.addCheckboxItem();
  itemWishlist.setTitle('5. 今後追加してほしい機能や、改善してほしい点はありますか？（複数選択可）')
    .setChoiceValues([
      '予定やチケット締切のリマインド通知',
      'Googleカレンダー / iOSカレンダーとの同期・出力',
      '推し友や家族との予定・グッズ共有機能',
      '遠征費・ホテル・交通費などの遠征専用管理',
      '推しの写真・スクショ・公式リンクのまとめ機能',
      'グッズの定価・フリマ相場メモ機能',
      'ホーム画面に置けるスマホウィジェット対応',
      '推しのイメージカラー設定・テーマの拡充'
    ])
    .showOtherOption(true);

  // --------------------------------------------------------------------------
  // 質問6: 不具合やわかりにくかった点 (自由記述)
  // --------------------------------------------------------------------------
  const itemIssues = form.addParagraphTextItem();
  itemIssues.setTitle('6. 画面が見づらかった箇所や、使いにくかった操作があれば教えてください')
    .setHelpText('ダークモードでの視認性、ボタンの押しやすさ、困ったことなど具体的にご自由にお書きください（任意）')
    .setRequired(false);

  // --------------------------------------------------------------------------
  // 質問7: 自由意見・メッセージ (自由記述)
  // --------------------------------------------------------------------------
  const itemMessage = form.addParagraphTextItem();
  itemMessage.setTitle('7. その他、ご要望や開発者へのメッセージがあればご自由にお聞かせください！')
    .setHelpText('「こんな推し活アプリにしてほしい！」「この機能が好き！」など何でも歓迎です（任意）')
    .setRequired(false);

  // --------------------------------------------------------------------------
  // 2. 回答集計用スプレッドシートの新規作成とフォーム連携
  // --------------------------------------------------------------------------
  const spreadsheet = SpreadsheetApp.create('【回答集計】推しサポ アンケート結果');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, spreadsheet.getId());

  // --------------------------------------------------------------------------
  // 3. 各種URLの取得とログ出力
  // --------------------------------------------------------------------------
  const publishedUrl = form.getPublishedUrl();
  const editUrl = form.getEditUrl();
  const spreadsheetUrl = spreadsheet.getUrl();
  const embedUrl = publishedUrl + (publishedUrl.includes('?') ? '&embedded=true' : '?embedded=true');

  Logger.log('================================================================');
  Logger.log('🎉 推しサポ アンケートGoogleフォームの作成が完了しました！');
  Logger.log('================================================================');
  Logger.log('');
  Logger.log('【1. アプリ設定用の回答フォームURL】');
  Logger.log(publishedUrl);
  Logger.log('');
  Logger.log('【2. アプリ内埋め込み用URL (iFrame用)】');
  Logger.log(embedUrl);
  Logger.log('');
  Logger.log('【3. フォーム編集画面URL】');
  Logger.log(editUrl);
  Logger.log('');
  Logger.log('【4. 回答集計スプレッドシートURL】');
  Logger.log(spreadsheetUrl);
  Logger.log('');
  Logger.log('================================================================');
  Logger.log('💡 次のステップ:');
  Logger.log('上記「【1. アプリ設定用の回答フォームURL】」をコピーして、');
  Logger.log('推しサポの「マイページ」→「アンケート・改善要望を送る」→「URL設定」に貼り付けてください。');
  Logger.log('================================================================');

  return {
    publishedUrl: publishedUrl,
    embedUrl: embedUrl,
    editUrl: editUrl,
    spreadsheetUrl: spreadsheetUrl,
  };
}
